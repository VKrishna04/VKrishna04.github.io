{
	"name": "vkrishna04.me",
	"version": "1.8.0",
	"type": "module",
	"homepage": "https://vkrishna04.me",
	"description": "Personal portfolio website showcasing skills, projects, and experiences.",
	"keywords": [
		"portfolio",
		"personal website",
		"react",
		"vite",
		"tailwindcss"
	],
	"markdown": "github",
	"author": "VKrishna04",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/VKrishna04/VKrishna04.github.io"
	},
	"bugs": {
		"url": "https://github.com/VKrishna04/VKrishna04.github.io/issues"
	},
	"engines": {
		"node": ">=16.0.0"
	},
	"main": "dist/index.js",
	"browser": "dist/index.js",
	"scripts": {
		"dev": "vite",
		"start": "npm run dev",
		"serve": "npx --yes http-server dist -p 4173 -c-1",
		"serve:dist": "npm run serve",
		"preview": "vite preview",
		"preview:dist": "npm run build-core && npm run serve",
		"lint": "eslint .",
		"validate": "npm run validate:integrity",
		"validate:integrity": "node scripts/validate-build-integrity.js",
		"validate:settings": "node scripts/validate-json.js public/settings.json && node scripts/validate-schema.js",
		"build": "npm run validate:integrity && npm run prepare-data && npm run build-core && node scripts/prerender.js && node scripts/generate-sw.js && node scripts/verify-attribution.js",
		"prepare-data": "node scripts/fetch-codeledger.js && node scripts/fetch-project-manifests.js && node scripts/generate-sitemap.js && node scripts/generate-ai-data.js",
		"prerender": "node scripts/prerender.js",
		"build-core": "node scripts/pre-build-validation.js && node scripts/generate-icon-map.js && vite build && node scripts/generate-manifest.js",
		"generate-icons": "node scripts/generate-icon-map.js",
		"build-future-cflarecounter": "node scripts/validate-build-integrity.js && node scripts/pre-build-validation.js && vite build && node scripts/generate-manifest.js && node scripts/register-cflair-projects.js",
		"validate-settings": "npm run validate:settings",
		"generate-manifest": "node scripts/generate-manifest.js",
		"generate-hashes": "node scripts/generate-hashes.js",
		"register-cflair": "node scripts/register-cflair-projects.js",
		"deploy:cloudflare": "npx wrangler deploy",
		"deploy:cloudflare:preview": "npx wrangler deploy --env preview",
		"setup-dev": "node scripts/setup-dev-env.js",
		"test-protection": "node scripts/protection-system-demo.js",
		"validate:schema": "node scripts/validate-schema.js"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"autoprefixer": "^10.4.21",
		"framer-motion": "^12.23.0",
		"postcss": "^8.5.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-icons": "^5.5.0",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.18.2",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^3.4.17",
		"typewriter-effect": "^2.22.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitejs/plugin-react": "^4.5.2",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"eslint": "^10.8.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.4",
		"globals": "^17.11.0",
		"jsonc-parser": "^3.3.1",
		"puppeteer": "^25.8.0",
		"vite": "^7.0.0"
	}
}
