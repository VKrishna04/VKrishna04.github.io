{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"description": "Footer configuration and content",
	"additionalProperties": false,
	"properties": {
		"copyright": {
			"type": "object",
			"description": "Copyright information configuration",
			"additionalProperties": false,
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 100,
					"description": "Name to display in copyright notice",
					"examples": [
						"Krishna GSVV"
					]
				},
				"showYear": {
					"type": "boolean",
					"description": "Whether to show the current year",
					"default": true
				},
				"text": {
					"type": "string",
					"minLength": 1,
					"maxLength": 50,
					"description": "Copyright text template",
					"examples": [
						"© {year} {name}. All rights reserved."
					]
				},
				"customText": {
					"type": "string",
					"minLength": 0,
					"maxLength": 100,
					"description": "Custom copyright text (overrides template if provided)",
					"examples": [
						"© Krishna GSVV. Built with ❤️"
					]
				}
			},
			"required": [
				"name"
			]
		},
		"madeWith": {
			"type": "object",
			"description": "Made with technology attribution",
			"additionalProperties": false,
			"properties": {
				"show": {
					"type": "boolean",
					"description": "Whether to show the 'made with' section",
					"default": true
				},
				"text": {
					"type": "string",
					"minLength": 1,
					"maxLength": 50,
					"description": "Text before the technology name",
					"examples": [
						"Made with",
						"Built with",
						"Powered by"
					]
				},
				"icon": {
					"type": "string",
					"description": "Icon to display (usually a heart or tech icon)",
					"examples": [
						"❤️",
						"⚡",
						"🚀",
						"FaHeart"
					]
				},
				"iconColor": {
					"type": "string",
					"description": "Tailwind CSS text color class for the icon",
					"examples": [
						"text-red-500",
						"text-blue-500"
					]
				},
				"color": {
					"type": "string",
					"pattern": "^#[0-9A-Fa-f]{6}$",
					"description": "Hex color for the icon",
					"examples": [
						"#ff0000",
						"#3b82f6"
					]
				},
				"by": {
					"type": "string",
					"minLength": 1,
					"maxLength": 30,
					"description": "Technology or framework name",
					"examples": [
						"React",
						"Vite",
						"Next.js",
						"VKrishna04"
					]
				}
			}
		},
		"socialLinks": {
			"type": "object",
			"description": "Social media links in footer",
			"additionalProperties": false,
			"properties": {
				"show": {
					"type": "boolean",
					"description": "Whether to show social links in footer",
					"default": true
				}
			}
		},
		"about": {
			"type": "object",
			"description": "About section in footer",
			"additionalProperties": false,
			"properties": {
				"show": {
					"type": "boolean",
					"description": "Whether to show about section in footer",
					"default": true
				},
				"title": {
					"type": "string",
					"minLength": 0,
					"maxLength": 50,
					"description": "Title for about section (empty string uses default name)",
					"examples": [
						"",
						"About Me",
						"Krishna GSVV"
					]
				},
				"description": {
					"type": "string",
					"minLength": 10,
					"maxLength": 300,
					"description": "Description text for the about section",
					"examples": [
						"Full-stack developer passionate about creating innovative web applications and contributing to open source projects. Always learning, always building."
					]
				}
			}
		},
		"stats": {
			"type": "object",
			"description": "Quick stats/achievements section",
			"additionalProperties": false,
			"properties": {
				"show": {
					"type": "boolean",
					"description": "Whether to show stats section",
					"default": true
				},
				"countProjectsFromData": {
					"type": "boolean",
					"description": "Whether to automatically count projects from projects data",
					"default": true
				},
				"items": {
					"type": "array",
					"maxItems": 5,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"key": {
								"type": "string",
								"enum": [
									"projects",
									"experience",
									"status",
									"custom"
								],
								"description": "Type of stat item"
							},
							"label": {
								"type": "string",
								"minLength": 1,
								"maxLength": 20,
								"description": "Label text for the stat"
							},
							"value": {
								"type": "string",
								"minLength": 1,
								"maxLength": 20,
								"description": "Value for the stat ('auto' for project counting)"
							},
							"color": {
								"type": "string",
								"pattern": "^text-[a-z-]+(-[0-9]+)?$",
								"description": "Tailwind CSS text color class"
							},
							"show": {
								"type": "boolean",
								"description": "Whether to show this stat item",
								"default": true
							}
						},
						"required": [
							"key",
							"label",
							"value",
							"color"
						]
					}
				}
			}
		},
		"quickLinks": {
			"type": "object",
			"description": "Quick navigation links section",
			"additionalProperties": false,
			"properties": {
				"show": {
					"type": "boolean",
					"description": "Whether to show quick links section (disabled since navbar is always visible)",
					"default": false
				}
			}
		},
		"styling": {
			"type": "object",
			"description": "Footer visual styling options",
			"additionalProperties": false,
			"properties": {
				"backgroundColor": {
					"type": "string",
					"description": "Tailwind CSS background classes for the footer",
					"examples": [
						"bg-gray-900/50 backdrop-blur-sm",
						"bg-black/80"
					]
				},
				"borderColor": {
					"type": "string",
					"description": "Tailwind CSS border color class for footer border",
					"examples": [
						"border-gray-800/50",
						"border-white/10"
					]
				},
				"textColor": {
					"type": "string",
					"description": "Tailwind CSS text color class for footer text",
					"examples": [
						"text-gray-400",
						"text-white"
					]
				},
				"copyrightColor": {
					"type": "string",
					"pattern": "^text-[a-z-]+(-[0-9]+)?$",
					"description": "Tailwind CSS text color class for copyright",
					"examples": [
						"text-gray-400",
						"text-slate-500"
					]
				}
			}
		},
		"note": {
			"type": "string",
			"description": "Documentation note for footer configuration guidance"
		}
	},
	"required": [
		"copyright"
	]
}