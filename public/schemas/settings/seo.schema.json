{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"description": "SEO configuration for meta tags, Open Graph, Twitter Card, and structured data",
	"additionalProperties": false,
	"properties": {
		"title": {
			"type": "string",
			"minLength": 1,
			"maxLength": 60,
			"description": "Primary page title for SEO",
			"examples": [
				"Your Name - Developer",
				"John Doe - Frontend Developer Portfolio"
			]
		},
		"description": {
			"type": "string",
			"minLength": 50,
			"maxLength": 160,
			"description": "Meta description for search engines (50-160 characters)",
			"examples": [
				"Passionate developer specializing in React, Python, and AI. Hackathon winner with ₹3.75L+ prize money. Building innovative solutions with 15+ open source projects."
			]
		},
		"keywords": {
			"type": "array",
			"minItems": 5,
			"maxItems": 20,
			"items": {
				"type": "string",
				"minLength": 2,
				"maxLength": 30
			},
			"description": "Array of keywords for search engines",
			"examples": [
				[
					"Full Stack Developer",
					"React",
					"Python",
					"AI",
					"Portfolio",
					"Open Source"
				]
			]
		},
		"author": {
			"type": "string",
			"minLength": 1,
			"maxLength": 50,
			"description": "Author name for meta tags",
			"examples": [
				"Your Name",
				"John Doe"
			]
		},
		"canonical": {
			"type": "string",
			"format": "uri",
			"description": "Canonical URL of the website",
			"examples": [
				"https://your-domain.example/",
				"https://johndoe.dev/"
			]
		},
		"crawling": {
			"type": "object",
			"description": "Who is allowed to crawl the site, and whether the machine-readable copies are published at all. Drives public/robots.txt and the AI data files, both generated at build time.",
			"additionalProperties": false,
			"properties": {
				"search": {
					"type": "boolean",
					"description": "Allow general search engines. False writes a site-wide Disallow into robots.txt.",
					"default": true
				},
				"aiTraining": {
					"type": "boolean",
					"description": "Allow AI and LLM crawlers (GPTBot, ClaudeBot, PerplexityBot, CCBot and friends). False names each one in robots.txt with a Disallow.",
					"default": true
				},
				"aiData": {
					"type": "boolean",
					"description": "Publish llms.txt, public/api/*.json and .well-known/ai-plugin.json. False skips generating them.",
					"default": true
				}
			}
		},
		"pageDescriptions": {
			"type": "object",
			"description": "Per-route meta descriptions, keyed by pathname (\"/about\", \"/projects\", ...). A route without an entry falls back to seo.description, which makes it compete with the homepage for the same search snippet. The homepage itself uses seo.description and needs no entry here.",
			"propertyNames": {
				"pattern": "^/[a-z0-9-/]*$",
				"description": "A route pathname beginning with \"/\"."
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 50,
				"maxLength": 300,
				"description": "The description Google may show as the snippet. Under ~160 characters is what actually renders."
			},
			"examples": [
				{
					"/about": "Background, skills, education and achievements."
				}
			]
		},
		"openGraph": {
			"type": "object",
			"description": "Open Graph configuration for social media sharing",
			"additionalProperties": false,
			"properties": {
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 60,
					"description": "Open Graph title",
					"examples": [
						"Your Name - Developer"
					]
				},
				"description": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200,
					"description": "Open Graph description",
					"examples": [
						"Passionate developer specializing in React, Python, and AI. Building innovative solutions with 15+ open source projects."
					]
				},
				"image": {
					"type": "string",
					"format": "uri",
					"description": "Open Graph image URL",
					"examples": [
						"https://github.com/your-username.png",
						"https://example.com/og-image.jpg"
					]
				},
				"imageWidth": {
					"type": "integer",
					"minimum": 200,
					"maximum": 2000,
					"description": "Open Graph image width",
					"default": 1200
				},
				"imageHeight": {
					"type": "integer",
					"minimum": 200,
					"maximum": 2000,
					"description": "Open Graph image height",
					"default": 630
				},
				"siteName": {
					"type": "string",
					"minLength": 1,
					"maxLength": 50,
					"description": "Website name for Open Graph",
					"examples": [
						"Your Name Portfolio",
						"John Doe Portfolio"
					]
				}
			},
			"required": [
				"title",
				"description",
				"image"
			]
		},
		"twitter": {
			"type": "object",
			"description": "Twitter Card configuration",
			"additionalProperties": false,
			"properties": {
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 70,
					"description": "Twitter card title",
					"examples": [
						"Your Name - Developer"
					]
				},
				"description": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200,
					"description": "Twitter card description",
					"examples": [
						"Passionate developer specializing in React, Python, and AI. Building innovative solutions."
					]
				},
				"image": {
					"type": "string",
					"format": "uri",
					"description": "Twitter card image URL",
					"examples": [
						"https://github.com/your-username.png"
					]
				},
				"creator": {
					"type": "string",
					"pattern": "^@[a-zA-Z0-9_]+$",
					"description": "Twitter handle of the creator",
					"examples": [
						"@your-handle",
						"@johndoe"
					]
				}
			},
			"required": [
				"title",
				"description",
				"image"
			]
		},
		"structuredData": {
			"type": "object",
			"description": "Schema.org structured data configuration",
			"additionalProperties": false,
			"properties": {
				"enabled": {
					"type": "boolean",
					"description": "Whether to include structured data",
					"default": true
				},
				"type": {
					"type": "string",
					"enum": [
						"Person",
						"Organization",
						"WebSite"
					],
					"description": "Schema.org type",
					"default": "Person"
				},
				"jobTitle": {
					"type": "string",
					"minLength": 1,
					"maxLength": 50,
					"description": "Job title for Person schema",
					"examples": [
						"Full Stack Developer",
						"Frontend Developer"
					]
				},
				"worksFor": {
					"type": "string",
					"minLength": 1,
					"maxLength": 50,
					"description": "Organization name",
					"examples": [
						"Independent",
						"Tech Company Inc."
					]
				},
				"sameAs": {
					"type": "array",
					"maxItems": 10,
					"items": {
						"type": "string",
						"format": "uri"
					},
					"description": "Array of social media URLs for structured data",
					"examples": [
						[
							"https://github.com/your-username",
							"https://linkedin.com/in/your-handle"
						]
					]
				},
				"knowsAbout": {
					"type": "array",
					"maxItems": 15,
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 30
					},
					"description": "Technologies and skills for structured data",
					"examples": [
						[
							"React",
							"Python",
							"Machine Learning",
							"Full Stack Development"
						]
					]
				}
			}
		},
		"customDomain": {
			"type": "string",
			"format": "hostname",
			"description": "Custom domain for CNAME generation (without protocol)",
			"examples": [
				"your-domain.example",
				"johndoe.dev",
				"portfolio.example.com"
			]
		}
	},
	"required": [
		"title",
		"description",
		"keywords",
		"author",
		"canonical"
	]
}