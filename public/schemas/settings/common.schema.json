{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Portfolio settings — shared definitions",
	"description": "Reusable value types referenced by every settings section. Referenced as common.schema.json#/definitions/<name> from a sibling section file, or schemas/settings/common.schema.json#/definitions/<name> from the root schema.",
	"definitions": {
		"url": {
			"oneOf": [
				{
					"type": "string",
					"const": "",
					"description": "Empty string for no URL"
				},
				{
					"type": "string",
					"format": "uri",
					"minLength": 1,
					"description": "A valid URL string"
				}
			],
			"description": "A valid URL string or empty string"
		},
		"color": {
			"type": "string",
			"pattern": "^#[0-9A-Fa-f]{6}$",
			"description": "A valid hex color code (e.g., #ff0000)"
		},
		"tailwindColor": {
			"type": "string",
			"pattern": "^(text|bg|border)-[a-z-]+(-[0-9]+)?$",
			"description": "A valid Tailwind CSS color class"
		},
		"iconName": {
			"type": "string",
			"pattern": "^[A-Z][a-zA-Z0-9]*$",
			"description": "A valid React Icons component name"
		},
		"githubUrl": {
			"oneOf": [
				{
					"type": "string",
					"const": "",
					"description": "Empty string for no GitHub URL"
				},
				{
					"type": "string",
					"format": "uri",
					"pattern": "^https://github\\.com/[^/]+/[^/]+/?$",
					"description": "A valid GitHub repository URL"
				}
			],
			"description": "A valid GitHub repository URL or empty string"
		},
		"githubStatsUrl": {
			"oneOf": [
				{
					"type": "string",
					"const": "",
					"description": "Empty string for no GitHub stats URL"
				},
				{
					"type": "string",
					"format": "uri",
					"pattern": "^https://github\\.com/[^/]+/[^/]+/(stargazers|network/members|watchers|issues)/?$",
					"description": "A valid GitHub repository statistics page URL"
				}
			],
			"description": "A valid GitHub repository statistics URL (stargazers, forks, watchers, issues) or empty string"
		},
		"dateString": {
			"type": "string",
			"format": "date",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
			"description": "A date in YYYY-MM-DD format"
		},
		"technologyTag": {
