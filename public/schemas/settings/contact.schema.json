{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"description": "Contact Page configuration and content settings",
	"additionalProperties": false,
	"properties": {
		"title": {
			"type": "string",
			"minLength": 1,
			"maxLength": 100,
			"description": "Main heading for the Contact Page",
			"default": "Let's Connect",
			"examples": [
				"Let's Connect",
				"Get In Touch",
				"Contact Me"
			]
		},
		"subtitle": {
			"type": "string",
			"minLength": 1,
			"maxLength": 500,
			"description": "Subtitle or description for the Contact Page",
			"default": "I'm always interested in new opportunities and collaborations. Let's build something amazing together!",
			"examples": [
				"I'm always interested in new opportunities and collaborations.",
				"Let's discuss your next project or just say hello!"
			]
		},
		"timeZone": {
			"type": "string",
			"description": "Timezone for displaying current local time",
			"default": "Asia/Kolkata",
			"examples": [
				"Asia/Kolkata",
				"America/New_York",
				"Europe/London",
				"America/Los_Angeles"
			]
		},
		"timeFormat": {
			"type": "string",
			"enum": [
				"12-hour",
				"24-hour"
			],
			"description": "Time format for displaying current time",
			"default": "12-hour"
		},
		"status": {
			"type": "object",
			"description": "Current availability status configuration",
			"additionalProperties": false,
			"properties": {
				"show": {
					"type": "boolean",
					"description": "Whether to display current status",
					"default": true
				},
				"available": {
					"type": "boolean",
					"description": "Current availability status",
					"default": true
				},
				"message": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200,
					"description": "Status message to display",
					"default": "Available for new opportunities",
					"examples": [
						"Available for new opportunities",
						"Currently open for collaborations",
						"Taking on new projects"
					]
				},
				"lastUpdated": {
					"type": "string",
					"format": "date",
					"description": "Last updated date in YYYY-MM-DD format"
				}
			},
			"required": [
				"show",
				"available",
				"message"
			]
		},
		"responseInfo": {
			"type": "object",
			"description": "Response time and availability information",
			"additionalProperties": false,
			"properties": {
				"show": {
					"type": "boolean",
					"description": "Whether to display response information",
					"default": true
				},
				"timeframe": {
					"type": "string",
					"minLength": 1,
					"maxLength": 100,
					"description": "Expected response timeframe",
					"default": "Usually within 24 hours",
					"examples": [
						"Usually within 24 hours",
						"Within 2-3 business days",
						"Same day response"
					]
				},
				"workingHours": {
					"type": "string",
					"minLength": 1,
					"maxLength": 100,
					"description": "Working hours in your timezone",
					"examples": [
						"9:00 AM - 6:00 PM IST",
						"Monday to Friday, 9-5 EST"
					]
				}
			},
			"required": [
				"show",
				"timeframe"
			]
		},
		"currentFocus": {
			"type": "object",
			"description": "What you're currently working on section",
			"additionalProperties": false,
			"properties": {
				"show": {
					"type": "boolean",
					"description": "Whether to display current focus section",
					"default": true
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 100,
					"description": "Title for the current focus section",
					"default": "What I'm Working On",
					"examples": [
						"What I'm Working On",
						"Current Projects",
						"My Focus"
					]
				},
				"description": {
					"type": "string",
					"minLength": 1,
					"maxLength": 500,
					"description": "Description of what you're currently working on",
					"examples": [
						"Building AI-powered web applications and contributing to open source projects.",
						"Developing modern React applications with focus on user experience."
					]
				}
			},
			"required": [
				"show",
				"title",
				"description"
			]
		},
		"collaborationInterests": {
			"type": "array",
			"description": "List of collaboration interests or project types",
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 100
			},
			"examples": [
				[
					"Full-stack web applications",
					"AI/ML integration projects",
					"Open source contributions"
				],
				[
					"React development",
					"Node.js APIs",
					"Mobile app development"
				]
			]
		},
		"quickActions": {
			"type": "object",
			"description": "Quick action buttons configuration",
			"additionalProperties": false,
			"properties": {
				"show": {
					"type": "boolean",
					"description": "Whether to display quick actions section",
					"default": true
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 100,
					"description": "Title for the quick actions section",
					"default": "Quick Actions"
				},
				"actions": {
					"type": "array",
					"description": "List of quick action buttons",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"label": {
								"type": "string",
								"minLength": 1,
								"maxLength": 50,
								"description": "Display text for the action button"
							},
							"icon": {
								"type": "string",
								"description": "Icon name for the action (Heroicons)",
								"examples": [
									"EnvelopeIcon",
									"CalendarDaysIcon",
									"DocumentIcon"
								]
							},
							"url": {
								"type": "string",
								"description": "URL or action for the button. Use {email} and {calendly} placeholders"
							},
							"colorTheme": {
								"type": "string",
								"description": "Color theme for the action button",
								"enum": [
									"blue",
									"green",
									"purple",
									"red",
									"yellow",
									"indigo",
									"pink",
									"gray"
								],
								"default": "blue"
							},
							"enabled": {
								"type": "boolean",
								"description": "Whether this action is enabled",
								"default": true
							}
						},
						"required": [
							"label",
							"icon",
							"url",
							"colorTheme",
							"enabled"
						]
					}
				}
			},
			"required": [
				"show",
				"title",
				"actions"
			]
		},
		"copy": {
			"type": "object",
			"description": "Controls copy-to-clipboard behavior on Contact page blocks.",
			"additionalProperties": false,
			"properties": {
				"enabled": {
					"type": "boolean",
					"default": true,
					"description": "Global toggle for Contact page copy buttons."
				},
				"showOnContactInfo": {
					"type": "boolean",
					"default": true,
					"description": "Show copy buttons for direct email/phone contact info."
				},
				"showOnQuickActions": {
					"type": "boolean",
					"default": true,
					"description": "Show copy buttons for quick action links."
				},
				"showOnPlatforms": {
					"type": "boolean",
					"default": true,
					"description": "Show copy buttons for social/contact platform cards."
				},
				"successDurationMs": {
					"type": "number",
					"minimum": 500,
					"maximum": 10000,
					"default": 2000,
					"description": "How long the copied state remains visible."
				},
				"tooltipPrefix": {
					"type": "string",
					"default": "Copy",
					"description": "Prefix text used in copy button tooltips."
				}
			}
		},
		"sections": {
			"type": "object",
			"description": "Layout configuration for Contact Page sections",
			"additionalProperties": false,
			"properties": {
				"platformSorting": {
					"type": "object",
					"description": "Configuration for sorting platforms within sections",
					"additionalProperties": false,
					"properties": {
						"iconOnlyFirst": {
							"type": "boolean",
							"description": "Whether to display icon-only platforms before platforms with descriptions",
							"default": true
						},
						"enabled": {
							"type": "boolean",
							"description": "Whether to enable custom sorting",
							"default": true
						}
					},
					"required": [
						"iconOnlyFirst",
						"enabled"
					]
				},
				"sectionHeadings": {
					"type": "object",
					"description": "Mapping of section numbers to section headings for grouping social platforms",
					"additionalProperties": false,
					"patternProperties": {
						"^[1-9]$|^10$": {
							"type": "string",
							"minLength": 1,
							"maxLength": 50,
							"description": "Section heading for the corresponding section number",
							"examples": [
								"Development",
								"Professional",
								"Creative",
								"Music & Entertainment"
							]
						}
					},
					"examples": [
						{
							"1": "Development & Code",
							"2": "Professional Networks",
							"3": "Creative & Design"
						}
					]
				},
				"leftColumn": {
					"type": "object",
					"description": "Left column configuration",
					"additionalProperties": false,
					"properties": {
						"title": {
							"type": "string",
							"description": "Title for the left column"
						},
						"sections": {
							"type": "array",
							"description": "Sections to display in left column",
							"items": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"type": {
										"type": "string",
										"enum": [
											"contactInfo",
											"currentFocus",
											"quickActions",
											"collaboration",
											"github",
											"social",
											"platforms",
											"section1",
											"section2",
											"section3",
											"section4",
											"section5",
											"section6",
											"section7",
											"section8",
											"section9",
											"section10"
										],
										"description": "Type of section to display"
									},
									"show": {
										"type": "boolean",
										"description": "Whether to show this section",
										"default": true
									},
									"title": {
										"type": "string",
										"description": "Custom title for this section"
									}
								},
								"required": [
									"type",
									"show"
								]
							}
						}
					},
					"required": [
						"title",
						"sections"
					]
				},
				"rightColumn": {
					"type": "object",
					"description": "Right column configuration",
					"additionalProperties": false,
					"properties": {
						"title": {
							"type": "string",
							"description": "Title for the right column"
						},
						"sections": {
							"type": "array",
							"description": "Sections to display in right column",
							"items": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"type": {
										"type": "string",
										"enum": [
											"github",
											"social",
											"collaboration",
											"platforms",
											"contactInfo",
											"currentFocus",
											"quickActions",
											"section1",
											"section2",
											"section3",
											"section4",
											"section5",
											"section6",
											"section7",
											"section8",
											"section9",
											"section10"
										],
										"description": "Type of section to display"
									},
									"show": {
										"type": "boolean",
										"description": "Whether to show this section",
										"default": true
									},
									"title": {
										"type": "string",
										"description": "Custom title for this section"
									}
								},
								"required": [
									"type",
									"show"
								]
							}
						}
					},
					"required": [
						"title",
						"sections"
					]
				}
			},
			"required": [
				"leftColumn",
				"rightColumn"
			]
		},
		"faq": {
			"type": "array",
			"description": "Frequently asked questions for the Contact Page",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"question": {
						"type": "string",
						"minLength": 1,
						"maxLength": 200,
						"description": "The question text"
					},
					"answer": {
						"type": "string",
						"minLength": 1,
						"maxLength": 1000,
						"description": "The answer text"
					}
				},
				"required": [
					"question",
					"answer"
				]
			},
			"examples": [
				[
					{
						"question": "What's your typical response time?",
						"answer": "I usually respond within 24 hours during weekdays."
					}
				]
			]
		},
		"calendly": {
			"oneOf": [
				{
					"type": "string",
					"const": "",
					"description": "Empty string for no Calendly integration"
				},
				{
					"type": "string",
					"format": "uri",
					"pattern": "^https://calendly\\.com/",
					"description": "Calendly scheduling URL"
				}
			],
			"description": "Calendly URL for scheduling meetings or empty string",
			"examples": [
				"https://calendly.com/your-username",
				""
			]
		},
		"note": {
			"type": "string",
			"description": "Configuration notes and instructions for the Contact Page setup"
		}
	},
	"required": [
		"title",
		"subtitle",
		"timeZone",
		"timeFormat",
		"status",
		"responseInfo"
	]
}